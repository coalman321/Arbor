<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="CitrusSynergy">
  <BehaviorTree ID="CitrusSynergy">
    <Sequence name="CitrusSynergy">
      <SubTree ID="Turtle"/>
      <Parallel name="DriveP1" success_count="1" failure_count="1">
        <FollowTrajectory trajectory="SynergyP1" end_state="IDLE"/>
        <Sequence name="P1Events">
          <SubTree ID="RunIntake"/>
          <KeepRunningUntilFailure name="Park">
            <AlwaysSuccess/>
          </KeepRunningUntilFailure>
        </Sequence>
      </Parallel>
      <TunableWait name="MiddleWait" key="CitrusSynergyBt/MiddleWaitTime" default_seconds="3"/>
      <SubTree ID="Shoot"/>
    </Sequence>
  </BehaviorTree>
</root>
