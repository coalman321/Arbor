{
  "name": "arbor",
  "version": "1.2.1",
  "private": true,
  "license": "MIT",
  "description": "Project-based editor and live viewer for BehaviorTree.CPP v4 trees",
  "author": "coalman321",
  "main": "build/desktop/main.cjs",
  "type": "module",
  "bin": {
    "arbor": "./bin/arbor.js"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server/main.ts --dev --project examples/demo_project",
    "build": "vite build",
    "start": "tsx src/server/main.ts",
    "mock-robot": "tsx src/mock/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:binary": "vite build && node scripts/build_binary.mjs",
    "bundle": "vite build && node scripts/bundle.mjs",
    "stage-git": "node scripts/stage_git.mjs",
    "desktop": "npm run bundle && npm run stage-git && electron .",
    "build:desktop": "npm run bundle && npm run stage-git && electron-builder --publish never"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5",
    "tsx": "^4.20.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.6.0",
    "@xyflow/react": "^12.8.1",
    "dugite": "^3.2.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "vitest": "^5.0.3",
    "zustand": "^5.0.6"
  },
  "build": {
    "appId": "io.github.coalman321.arbor",
    "productName": "Arbor",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "build/desktop/**",
      "dist/**",
      "resources/icon.png",
      "package.json",
      "!**/node_modules/**"
    ],
    "extraResources": [
      {
        "from": "build/git",
        "to": "git"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "artifactName": "Arbor-${version}-${os}-${arch}.${ext}"
  }
}
